<ul class="lines">
	<li>
		<strong class="trolleys">Тролеи:</strong>
		<div class="lines-wrapper">
			{{#each trolleybus}}
				<a class="trolley nowrap" href="#/trolley/{{this}}" data-line-name="{{this}}">{{this}}</a>
			{{/each}}
		</div>
	</li>
	<li>
		<strong class="trams">Трамваи:</strong>
		<div class="lines-wrapper">
			{{#each tram}}
				<a class="tram nowrap" href="#/tram/{{this}}" data-line-name="{{this}}">{{this}}</a>
			{{/each}}
		</div>
	</li>
	<li>
		<strong class="buses">Автобуси:</strong>
		<div class="lines-wrapper">
			{{#each bus}}
				<a class="bus nowrap" href="#/bus/{{this}}" data-line-name="{{this}}">{{this}}</a>
			{{/each}}
		</div>
	</li>
	<li>
		<strong class="buses">Нощни автобуси:</strong>
		<div class="lines-wrapper">
			{{#each nightbus}}
				<a class="nightbus nowrap" href="#/nightbus/{{this}}" data-line-name="{{this}}">{{this}}</a>
			{{/each}}
		</div>
	</li>
	<li>
		<strong class="subways">Метро:</strong>
		<div class="lines-wrapper">
			{{#each subway}}
				<a class="subway nowrap" href="#/subway/{{this}}" data-line-name="{{this}}">{{this}}</a>
			{{/each}}
		</div>
	</li>
</ul>
